# Sequoia crypto-policy override used by apt's signature verifier (sqv) at
# build time.
#
# Debian 13 (trixie) rejects SHA1 signatures from 2026-02-01. The Raspberry Pi
# archive signing key's own self-signature (User ID certification and subkey
# binding) still uses SHA1, so apt refuses to validate the key and treats the
# repo as unsigned. Re-allowing SHA1 lets that key validate while leaving all
# other signature verification intact (Debian's own keys do not use SHA1).
#
# Remove this file once the upstream Raspberry Pi archive key is re-signed with
# a modern digest (still SHA1 as of 2026-06).
[hash_algorithms.sha1]
collision_resistance = "always"
second_preimage_resistance = "always"
